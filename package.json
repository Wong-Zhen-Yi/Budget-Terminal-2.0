{
  "name": "budget-terminal",
  "version": "0.1.0",
  "private": true,
  "description": "Budget Terminal - Electron rebuild",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1",
    "npm": ">=10.9.8"
  },
  "workspaces": [
    "apps/desktop"
  ],
  "scripts": {
