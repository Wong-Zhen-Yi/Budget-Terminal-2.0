    "probe:bmnr": "npm run --workspace budget-terminal-desktop probe:bmnr --",
    "probe:sp500": "npm run --workspace budget-terminal-desktop probe:sp500 --",
    "probe:gold": "npm run --workspace budget-terminal-desktop probe:gold --",
